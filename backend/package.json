{
  "name": "ishoes-backend",
  "version": "1.0.0",
  "description": "I.Shoes Express and Supabase backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:catalog": "node scripts/seedCatalog.js",
    "verify:supabase": "node scripts/verifySupabase.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
